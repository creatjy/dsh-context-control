{
  "name": "dsh-context-control",
  "version": "0.6.10",
  "description": "Context control for DeepSeek Harness: inspect token usage, lazily load skills/MCP/plugins per session, and compact on demand.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "icon.svg",
    "icon.png",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "context",
    "context-window",
    "token",
    "compaction"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "author": "creatjy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creatjy/dsh-context-control.git"
  },
  "homepage": "https://github.com/creatjy/dsh-context-control#readme",
  "bugs": {
    "url": "https://github.com/creatjy/dsh-context-control/issues"
  }
}
